-- lua/config/autocmds/transparency.lua
-- All background-clearing highlights live here.

local set_hl = vim.api.nvim_set_hl

local function apply()
    --------------------------------------------------------------------------
    -- Core UI
    --------------------------------------------------------------------------
    set_hl(0, "Normal", { bg = "none" })
    set_hl(0, "NormalNC", { bg = "none" })
    set_hl(0, "NormalFloat", { bg = "none" })
    set_hl(0, "FloatBorder", { bg = "none" })
    set_hl(0, "SignColumn", { bg = "none" })
    set_hl(0, "LineNr", { bg = "none" })

    --------------------------------------------------------------------------
    -- Statusline / Tabline
    --------------------------------------------------------------------------
    set_hl(0, "StatusLine", { bg = "none" })
    set_hl(0, "StatusLineNC", { bg = "none" })
    set_hl(0, "BufferLineFill", { bg = "none" })
    set_hl(0, "BufferLineBackground", { bg = "none" })

    --------------------------------------------------------------------------
    -- Popular plugin windows
    --------------------------------------------------------------------------
    set_hl(0, "TelescopeNormal", { bg = "none" })
    set_hl(0, "TelescopeBorder", { bg = "none" })
    set_hl(0, "ToggleTermNormal", { bg = "none" })
    set_hl(0, "ToggleTermBorder", { bg = "none" })
    set_hl(0, "MasonNormal", { bg = "none" })
    set_hl(0, "MasonBorder", { bg = "none" })
    -- add more plugin-specific groups here if needed
end

-- Run once on startup and every time the colorscheme changes
vim.api.nvim_create_autocmd("ColorScheme", {
    group = vim.api.nvim_create_augroup("TransparentBG", { clear = true }),
    callback = apply,
})

apply() -- apply immediately at startup
