{
    "global": {
        "check_for_updates": false,
        "enable_notification_window": false
    },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Map brightness controls to fine brightness controls (Opt + Shift + F1/F2)",
                        "manipulators": [
                            {
                                "from": { "key_code": "f1" },
                                "to": [
                                    {
                                        "key_code": "display_brightness_decrement",
                                        "modifiers": ["left_shift", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "f1",
                                    "modifiers": { "mandatory": ["fn"] }
                                },
                                "to": [
                                    {
                                        "key_code": "f1",
                                        "modifiers": ["fn"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": { "key_code": "f2" },
                                "to": [
                                    {
                                        "key_code": "display_brightness_increment",
                                        "modifiers": ["left_shift", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "f2",
                                    "modifiers": { "mandatory": ["fn"] }
                                },
                                "to": [
                                    {
                                        "key_code": "f2",
                                        "modifiers": ["fn"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Disable Cmd+H",
                        "manipulators": [
                            {
                                "description": "",
                                "from": {
                                    "key_code": "h",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Ctrl+Cmd+Delete to Lock Screen",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "delete_or_backspace",
                                    "modifiers": { "mandatory": ["control", "command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "q",
                                        "modifiers": ["left_control", "left_command"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Ctrl+P / Ctrl+N / Ctrl+F / Ctrl+B as arrow keys",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "p",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [{ "key_code": "up_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "n",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [{ "key_code": "down_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "f",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [{ "key_code": "right_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "b",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [{ "key_code": "left_arrow" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Ctrl+W as backward word delete",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "com.googlecode.iterm2",
                                            "net.kovidgoyal.kitty",
                                            "co.zeit.hyper",
                                            "com.apple.Terminal",
                                            "io.alacritty",
                                            "com.mitchellh.ghostty"
                                        ],
                                        "type": "frontmost_application_unless"
                                    }
                                ],
                                "from": {
                                    "key_code": "w",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [
                                    {
                                        "key_code": "delete_or_backspace",
                                        "modifiers": ["option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "simple_modifications": [
                {
                    "from": { "key_code": "right_command" },
                    "to": [{ "key_code": "left_control" }]
                }
            ],
            "virtual_hid_keyboard": {
                "indicate_sticky_modifier_keys_state": false,
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}